{
  "rules": {
    ".read": false,
    ".write": false,

    "live": {
      "$tenantId": {
        "$boardId": {
          "state": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator' || auth.token.role === 'viewer' || ((auth.token.role === 'overlay' || auth.token.role === 'mirror') && auth.token.boardId === $boardId))",

            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator')",

            // periodScores, scheduleId, and logoUrl are deliberately absent from
            // this list: RTDB strips a key whose value is an empty object or
            // null, so a fresh board (periodScores: {}), one with no schedule
            // link (scheduleId: null), or one with no tournament logo uploaded
            // yet (logoUrl: null) legitimately omits them from the write —
            // requiring them here would make every freshly-created board fail
            // its own first write.
            ".validate": "newData.hasChildren(['sport','period','possession','home','away','gameClock','shotClock','config','rev','updatedAt','updatedBy','matchStartedAt'])",

            "sport": {
              ".validate": "newData.isString() && newData.val() === 'basketball'"
            },
            "period": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
            },
            "possession": {
              ".validate": "newData.isString() && (newData.val() === 'home' || newData.val() === 'away')"
            },

            "home": {
              ".validate": "newData.hasChildren(['name','score','fouls','timeouts'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "fouls": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "timeouts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "$other": { ".validate": false }
            },

            "away": {
              ".validate": "newData.hasChildren(['name','score','fouls','timeouts'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "fouls": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "timeouts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "$other": { ".validate": false }
            },

            "gameClock": {
              ".validate": "newData.hasChildren(['running','remainingMs']) && newData.child('running').val() === newData.child('endsAt').exists()",
              "running": { ".validate": "newData.isBoolean()" },
              "endsAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "remainingMs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5999000"
              },
              "$other": { ".validate": false }
            },

            "shotClock": {
              ".validate": "newData.hasChildren(['running','remainingMs']) && newData.child('running').val() === newData.child('endsAt').exists()",
              "running": { ".validate": "newData.isBoolean()" },
              "endsAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "remainingMs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99000"
              },
              "$other": { ".validate": false }
            },

            "config": {
              ".validate": "newData.hasChildren(['periodLengthMs','shotClockMs','shotClockResetMs','timeouts','periodCount','startingPeriod','foulBonusAt','homeTeamName','awayTeamName','showTenthsUnderOneMinute'])",
              "periodLengthMs": {
                ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 5999000"
              },
              "shotClockMs": {
                ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 99000"
              },
              "shotClockResetMs": {
                ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 99000"
              },
              "timeouts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "periodCount": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
              },
              "startingPeriod": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
              },
              "foulBonusAt": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
              },
              "homeTeamName": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "awayTeamName": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "showTenthsUnderOneMinute": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },

            "rev": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() === data.val() + 1)"
            },

            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 120000 && newData.val() >= now - 600000"
            },

            "updatedBy": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },

            "matchStartedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "periodScores": {
              "$period": {
                ".validate": "newData.hasChildren(['home','away'])",
                "home": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
                },
                "away": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
                },
                "$other": { ".validate": false }
              }
            },

            "scheduleId": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },

            "logoUrl": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 600"
            },

            "$other": { ".validate": false }
          },

          "presence": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator' || auth.token.role === 'viewer')",
            "$connectionId": {
              ".write": "auth != null && auth.token.tenantId === $tenantId && (!newData.exists() || newData.child('uid').val() === auth.uid)",
              ".validate": "newData.hasChildren(['uid','role','ts'])",
              "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
              "role": { ".validate": "newData.isString() && newData.val().length <= 32" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
