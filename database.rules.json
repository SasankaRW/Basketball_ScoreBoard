{
  "rules": {
    ".read": false,
    ".write": false,

    "live": {
      "$tenantId": {
        "$boardId": {
          "state": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator' || auth.token.role === 'viewer' || ((auth.token.role === 'overlay' || auth.token.role === 'mirror') && auth.token.boardId === $boardId))",

            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator')",

            // periodScores, scheduleId, and logoUrl are deliberately absent from
            // this list: RTDB strips a key whose value is an empty object or
            // null, so a fresh board (periodScores: {}), one with no schedule
            // link (scheduleId: null), or one with no tournament logo uploaded
            // yet (logoUrl: null) legitimately omits them from the write —
            // requiring them here would make every freshly-created board fail
            // its own first write.
            ".validate": "newData.hasChildren(['sport','period','possession','home','away','gameClock','shotClock','config','rev','updatedAt','updatedBy','matchStartedAt'])",

            "sport": {
              ".validate": "newData.isString() && newData.val() === 'basketball'"
            },
            "period": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
            },
            "possession": {
              ".validate": "newData.isString() && (newData.val() === 'home' || newData.val() === 'away')"
            },

            "home": {
              // timeoutsUsed is absent from this list on purpose: a game that
              // was already in progress when the field shipped has teams
              // written without it, and requiring it would make that board's
              // next write fail. parseLiveBoardState defaults it to 0.
              ".validate": "newData.hasChildren(['name','score','fouls','timeouts'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "fouls": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "timeouts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "timeoutsUsed": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "$other": { ".validate": false }
            },

            "away": {
              ".validate": "newData.hasChildren(['name','score','fouls','timeouts'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "fouls": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "timeouts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "timeoutsUsed": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "$other": { ".validate": false }
            },

            "gameClock": {
              ".validate": "newData.hasChildren(['running','remainingMs']) && newData.child('running').val() === newData.child('endsAt').exists()",
              "running": { ".validate": "newData.isBoolean()" },
              "endsAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "remainingMs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5999000"
              },
              "$other": { ".validate": false }
            },

            "shotClock": {
              ".validate": "newData.hasChildren(['running','remainingMs']) && newData.child('running').val() === newData.child('endsAt').exists()",
              "running": { ".validate": "newData.isBoolean()" },
              "endsAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "remainingMs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99000"
              },
              "$other": { ".validate": false }
            },

            "config": {
              ".validate": "newData.hasChildren(['periodLengthMs','shotClockMs','shotClockResetMs','timeouts','periodCount','startingPeriod','foulBonusAt','homeTeamName','awayTeamName','showTenthsUnderOneMinute'])",
              "periodLengthMs": {
                ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 5999000"
              },
              "shotClockMs": {
                ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 99000"
              },
              "shotClockResetMs": {
                ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 99000"
              },
              "timeouts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
              },
              "periodCount": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
              },
              "startingPeriod": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
              },
              "foulBonusAt": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
              },
              "homeTeamName": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "awayTeamName": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "showTenthsUnderOneMinute": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },

            "rev": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() === data.val() + 1)"
            },

            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 120000 && newData.val() >= now - 600000"
            },

            "updatedBy": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },

            "matchStartedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "periodScores": {
              "$period": {
                ".validate": "newData.hasChildren(['home','away'])",
                "home": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
                },
                "away": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
                },
                "$other": { ".validate": false }
              }
            },

            "scheduleId": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },

            "logoUrl": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 600"
            },

            "$other": { ".validate": false }
          },

          // The play-by-play for the game currently on this board: every
          // basket, foul, timeout and period change, appended as it happens and
          // harvested into the permanent match record by finishMatch. Readable
          // by any member of the tenant (and by this board's mirror/overlay,
          // matching how `state` is read); writable only by the same roles that
          // may run a game, because an event nobody could have caused is worse
          // than no event at all.
          "events": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator' || auth.token.role === 'viewer' || ((auth.token.role === 'overlay' || auth.token.role === 'mirror') && auth.token.boardId === $boardId))",

            // Whole-node writes are how the timeline gets cleared: finishMatch
            // removes it after harvesting, and NEW_GAME discards it with the
            // game. Only a delete is allowed here — appending goes through
            // $eventId below, so a single write cannot replace the history.
            //
            // This necessarily also permits deleting the sole remaining entry,
            // since to the database that write and clearing the node are the
            // same thing. Both leave an empty timeline, which is exactly what
            // discarding a game is supposed to produce, so there is nothing to
            // separate. Removing one entry from among others stays denied,
            // which is the property that actually protects the record.
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator') && !newData.exists()",

            "$eventId": {
              // Append-only: an existing entry can never be rewritten or
              // deleted individually. A timeline that can be edited after the
              // fact is not a record of anything.
              ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator') && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['ts','period','clockMs','type','delta','home','away','actor'])",
              "ts": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "period": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
              },
              "clockMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "type": {
                ".validate": "newData.isString() && (newData.val() === 'score' || newData.val() === 'foul' || newData.val() === 'timeout' || newData.val() === 'period')"
              },
              // Absent for whole-game events such as a period change — RTDB
              // strips the null, so this is only validated when present.
              "side": {
                ".validate": "newData.isString() && (newData.val() === 'home' || newData.val() === 'away')"
              },
              "delta": {
                ".validate": "newData.isNumber() && newData.val() >= -99 && newData.val() <= 99"
              },
              "home": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "away": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "actor": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "$other": { ".validate": false }
            }
          },

          // How this board's sections are arranged on screen, when somebody
          // has arranged them. Absent for the overwhelming majority of boards,
          // and absent is not a gap to fill: it is the instruction to render
          // the stock layout the scoreboard shipped with, which is why "reset
          // to defaults" deletes this node rather than writing a default into
          // it.
          //
          // Deliberately a sibling of `state` rather than a child. `state.rev`
          // must advance by exactly one per write and every basket is a
          // transaction against it; an admin dragging a box in the layout
          // editor has no business competing with a scorer at the table for
          // the same revision.
          //
          // Read by anyone who may read the board — the gym-wall scoreboard
          // and the mirror both need it to paint, and the mirror holds only a
          // board-scoped viewer token. Written by the roles that may run a
          // game, because the arrangement of the board is part of operating
          // it. The bounds below are hand-mirrored from LAYOUT_LIMITS in
          // src/core/boardLayout.ts, the same way `state`'s are from LIMITS in
          // schema.ts — there is no codegen link, so change one, change the
          // other.
          "layout": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator' || auth.token.role === 'viewer' || ((auth.token.role === 'overlay' || auth.token.role === 'mirror') && auth.token.boardId === $boardId))",

            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator')",

            ".validate": "newData.hasChildren(['version','sections'])",

            "version": {
              ".validate": "newData.isNumber() && newData.val() === 1"
            },

            "sections": {
              "$sectionId": {
                // scale, visible and showLabel are absent from this list on
                // purpose: a layout written by an older build legitimately
                // omits them, and parseBoardLayout fills each from the
                // section's own default rather than from zero.
                ".validate": "newData.hasChildren(['x','y','w','h'])",
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 200"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 200"
                },
                "w": {
                  ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 200"
                },
                "h": {
                  ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 200"
                },
                "scale": {
                  ".validate": "newData.isNumber() && newData.val() >= 0.2 && newData.val() <= 3"
                },
                "visible": { ".validate": "newData.isBoolean()" },
                "showLabel": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              }
            },

            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 120000 && newData.val() >= now - 600000"
            },

            "updatedBy": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },

            "$other": { ".validate": false }
          },

          "presence": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || auth.token.role === 'admin' || auth.token.role === 'operator' || auth.token.role === 'viewer')",
            "$connectionId": {
              ".write": "auth != null && auth.token.tenantId === $tenantId && (!newData.exists() || newData.child('uid').val() === auth.uid)",
              ".validate": "newData.hasChildren(['uid','role','ts'])",
              "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
              "role": { ".validate": "newData.isString() && newData.val().length <= 32" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
