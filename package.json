{
  "name": "scoreboard-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant basketball scoreboard platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:functions": "npm --prefix functions run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,html,md}\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "firebase emulators:exec --only database \"vitest run --project integration\"",
    "test:rules": "firebase emulators:exec --only database,firestore,storage \"vitest run --project rules\"",
    "test:e2e": "npm run build && npm run build:functions && firebase emulators:exec --only auth,database,firestore,storage,functions,hosting \"playwright test --project=e2e\"",
    "test:e2e:ui": "playwright test --project=e2e --ui",
    "test:visual": "npm run build && npm run build:functions && firebase emulators:exec --only auth,database,firestore,storage,functions,hosting \"playwright test --project=visual\"",
    "baseline": "npm run build && npm run build:functions && firebase emulators:exec --only auth,database,firestore,storage,functions,hosting \"playwright test --project=visual --update-snapshots\"",
    "emulators": "firebase emulators:start --only auth,database,firestore,storage,functions,hosting --import=./.emulator-data --export-on-exit=./.emulator-data",
    "coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^3.23.2",
    "firebase-tools": "^13.29.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util@1.12.1": true,
    "protobufjs@7.6.5": true
  }
}
